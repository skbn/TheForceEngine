SRCS := $(MAIN_SRC) $(AUDIO_SRC) $(INPUT_SRC) $(FRONTENDUI_SRC) $(REND_SRC) $(DARKFORCES_SRC) $(OUTLAWS_SRC) $(ASSET_SRC) $(MEMORY_SRC) $(GAME_SRC) $(JEDI_SRC) $(SETTINGS_SRC) $(ARCHIVE_SRC) $(FILESYSTEM_SRC) $(SYSTEM_SRC) $(AMIGA_SRC)
OBJS := $(addprefix $(OBJDIR)/, $(notdir $(filter %.o, $(SRCS:.cpp=.o) $(SRCS:.s=.o))))

vpath %.cpp $(sort $(dir $(filter %.cpp, $(SRCS))))
vpath %.s $(sort $(dir $(filter %.s, $(SRCS))))

TARGET = TheForceEngine.$(CPU)$(FPU_SUFFIX)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) -o $@ $^ $(LDFLAGS) -Wl,-Map=$@.map
ifneq ($(DEBUG), 1)
	$(STRIP) $@
endif
	python3 bss2hunk.py $(TARGET)

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(OBJDIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.s
	@mkdir -p $(OBJDIR)
	$(AS) $< -o $@

.PHONY: clean

clean:
	$(RM) -r $(OBJDIR)
	$(RM) $(TARGET) $(TARGET).map
