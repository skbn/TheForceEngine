CC := m68k-amigaos-gcc
CXX := m68k-amigaos-g++

STRIP := m68k-amigaos-strip
RM := rm -f

CPU ?= 030
FPU ?= 0

ifeq ($(CPU),060)
ARCH = -m68060
AS_CPU = -m68060
else ifeq ($(CPU),040)
ARCH = -m68040
AS_CPU = -m68040
else ifeq ($(CPU),030)
ARCH = -m68030
AS_CPU = -m68030
else ifeq ($(CPU),020)
ARCH = -m68020
AS_CPU = -m68020
else
$(error Unsupported CPU=$(CPU). Use 020, 030, 040 or 060)
endif

ifeq ($(FPU),1)
ARCH += -mhard-float
FPU_SUFFIX = _fpu
else
ARCH += -msoft-float
FPU_SUFFIX =
endif

# Fix toolchain bug: link_cpu forces libm881 (hard-float) for 68040/060 even with -msoft-float
ifeq ($(FPU),0)
SPECS_FLAG := -specs=softfloat.specs
else
SPECS_FLAG :=
endif

ROOTDIR := $(abspath $(dir $(shell which vasmm68k_mot))/..)
AS = vasmm68k_mot -quiet -I$(ROOTDIR)/m68k-amigaos/ndk-include -Fhunk -phxass $(AS_CPU) -opt-allbra -opt-brajmp -opt-clr -opt-div -opt-fconst -opt-jbra -opt-lsl -opt-movem -opt-mul -opt-nmoveq -opt-pea -opt-st -opt-speed -showcrit

DEBUG ?= 0
DEFINES := -DUSE_ASM -DCPU_$(CPU)
DEFINES +=-DQUANT_ASM

ifeq ($(FPU),1)
DEFINES += -DTFE_HAVE_FPU
endif
INCLUDES := -I. -Iamiga
CFLAGS := $(ARCH) $(DEFINES) $(INCLUDES) -fno-common -noixemul -fpermissive
ifneq ($(DEBUG), 1)
CFLAGS += -O2 -DNDEBUG -fomit-frame-pointer -fpermissive
CFLAGS += -ffast-math -fbbb=-
#CFLAGS += -fno-math-errno -fno-signaling-nans -fno-trapping-math -freciprocal-math -fno-peephole2
else
CFLAGS += -g -D_DEBUG
endif
#CFLAGS += -save-temps
#CFLAGS += -fstack-usage -Wstack-usage=1024
CFLAGS += -Wall -Wno-unused-variable -Wno-switch -Wno-sign-compare -fpermissive
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti -fpermissive

LDFLAGS := -noixemul $(SPECS_FLAG) -lm $(ARCH) -ldebug -Wl,--noinhibit-exec # -fno-exceptions -fno-rtti

OBJDIR = obj_$(CPU)$(FPU_SUFFIX)

